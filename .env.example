# ===== BillyCord Environment Variables =====
# Copy this to .env and fill in values.

# Server Configuration
NODE_ENV=production
PORT=3001

# Database - REQUIRED
# Local PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_clone

# Redis - OPTIONAL (app works without it using in-memory cache)
# REDIS_URL=redis://localhost:6379

# Authentication - REQUIRED (change these to random strings!)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Admin Dashboard Secret
ADMIN_SECRET=billycord-admin-2024

# File Upload
UPLOAD_MAX_SIZE=10485760

# Client URL - OPTIONAL
# CLIENT_URL=http://localhost:5173

# WebRTC TURN/STUN servers (optional - public STUN used by default)
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
