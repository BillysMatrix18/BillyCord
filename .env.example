# ===== Discord Clone Environment Variables =====
#
# For Replit: Set these as Secrets in the Secrets tab (lock icon).
# For local dev: Copy this to .env and fill in values.

# Server Configuration
NODE_ENV=production
PORT=3001

# Database - REQUIRED
# Replit: Use the connection string from your Replit PostgreSQL add-on
# Local: postgresql://postgres:postgres@localhost:5432/discord_clone
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_clone

# Redis - OPTIONAL (app works without it using in-memory cache)
# REDIS_URL=redis://localhost:6379

# Authentication - REQUIRED (change these to random strings!)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# File Upload
UPLOAD_MAX_SIZE=10485760

# Client URL - OPTIONAL
# Leave unset for same-origin serving (Replit default)
# CLIENT_URL=http://localhost:5173

# Email (optional - for verification and password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@discord-clone.com

# OAuth2 (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# WebRTC TURN/STUN servers (optional - public STUN used by default)
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
