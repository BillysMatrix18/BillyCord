# ===== Replit Deployment Configuration =====
# Copy this file to .env and fill in values.
# On Replit, set these as Secrets in the Secrets tab (lock icon in sidebar).

# Database - REQUIRED
# Replit provides PostgreSQL. Use the connection string from your Replit PostgreSQL add-on.
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:5432/discord_clone

# Authentication - REQUIRED (change these!)
# Generate random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# Server Configuration
NODE_ENV=production
PORT=3001

# Redis - OPTIONAL
# If not set, the app uses an in-memory cache (works fine for single-instance Replit deploys)
# REDIS_URL=redis://localhost:6379

# File Upload
UPLOAD_MAX_SIZE=10485760

# Client URL - OPTIONAL
# If not set, CORS allows same-origin and Replit domains automatically
# CLIENT_URL=https://your-repl-name.your-username.repl.co
