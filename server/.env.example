# ===== BillyCord Server Configuration =====
# Copy this file to .env and fill in values.

# Database — SQLite (auto-created, no setup needed)
# DB_PATH=./billycord.db

# Authentication - REQUIRED (change these!)
# Generate random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# Server Configuration
NODE_ENV=production
PORT=3001

# Admin Dashboard Secret
ADMIN_SECRET=billycord-admin-2024

# Redis - OPTIONAL (uses in-memory cache if not set)
# REDIS_URL=redis://localhost:6379

# File Upload
UPLOAD_MAX_SIZE=10485760
